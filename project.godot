; Engine Configuration File.
; Godot version: 4.4
; Template for Pixel Art Card Game

[application]
config/name="MyPixelCardGame"
config/description="Pixel art roguelike card game"
run/main_scene="res://src/Godot/Scenes/MainMenu.tscn"
config/features=PackedStringArray("4.4", "C#", "Mobile")
boot_splash/bg_color=Color(0.141176, 0.141176, 0.141176, 1)

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=DisplayServer.SCREEN_LANDSCAPE

[dotnet]
project/assembly_name="MyGame"

[gui]
timers/tooltip_delay_sec=0.5
theme/default_theme_scale=1.0

