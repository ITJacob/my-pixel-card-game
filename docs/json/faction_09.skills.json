    {
      "id": "f09_deep_fall",
      "name": "沉沦",
      "kind": "passive",
      "sequence": 9,
      "rarity": "common",
      "axis": "abyss",
      "flagship": false,
      "describe": "被动。自身回合开始时读取死亡簿：累计死亡 ≥3 时，获得「沉溺」（伤害 +1，每回合重判）——死得越多，沉沦越深。",
      "hook": [
        "on_turn_start"
      ],
      "effects": [
        {
          "op": "if",
          "condition": {
            "kind": "meter_compare",
            "key": "death_tally",
            "cmp": ">=",
            "n": 3
          },
          "then": [
            {
              "type": "mount_status",
              "statusId": "deep_dive",
              "duration": 1,
              "durationUnit": "self_turn",
              "refresh": true,
              "target": "self",
              "note": "沉溺：死亡簿 ≥3 挂载（伤害 +1）"
            }
          ],
          "else": []
        }
      ],
      "tentative": false
    },
    {
