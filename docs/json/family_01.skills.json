    },
    {
      "id": "j01_arms_mastery",
      "name": "兵械通晓",
      "kind": "passive",
      "initialEquip": "h01_standard_blade",
      "sequence": 9,
      "rarity": "common",
      "axis": "martial",
      "flagship": false,
      "describe": "战斗开始时装备制式长剑（耐久 4 次）：攻击 +1；自身护甲 +3；战意：每次击杀积 1 层（不受回合上限限制，主动技能可消耗）；若击杀的是已登记将死的目标，改为积 2 层；若击杀时已有战意 ≥3，额外积 1 层。",
      "hook": [
        "on_battle_start"
      ],
      "effects": [
        {
          "type": "modify_resource",
          "resource": "armor",
          "value": 3,
          "mode": "delta",
          "target": "self"
        }
      ],
      "tentative": false,
      "triggers": [
        {
          "event": "on_kill",
          "effects": [
            {
              "op": "if",
              "condition": {
                "kind": "has_status",
                "side": "self",
                "id": "war_spirit",
                "cmp": ">=",
                "n": 3
              },
              "then": [
                {
                  "type": "mount_status",
                  "statusId": "war_spirit",
                  "stacks": 1,
                  "stackMode": "add",
                  "target": "self",
                  "ignoreWarSpiritCap": true,
                  "note": "熟械：战意已足，击杀再积 1 层"
                }
              ],
              "else": [],
              "note": "战意读档：击杀时 ≥3 层，额外积 1 层"
            },
            {
              "op": "if",
              "condition": {
                "kind": "has_status",
                "side": "target",
                "id": "doom_mark",
                "cmp": ">=",
                "n": 1
              },
              "then": [
                {
                  "type": "mount_status",
                  "statusId": "war_spirit",
                  "stacks": 2,
                  "stackMode": "add",
                  "target": "self",
                  "note": "宣判兑现：击杀将死目标双倍战意",
                  "ignoreWarSpiritCap": true
                }
              ],
              "else": [
                {
                  "type": "mount_status",
                  "statusId": "war_spirit",
                  "stacks": 1,
                  "stackMode": "add",
                  "target": "self",
                  "ignoreWarSpiritCap": true
                }
              ],
              "note": "兵械通晓：击杀产战意；已登记目标额外奖励"
            }
          ]
        }
      ]
    },
