      "describe": "徒手擒拿：对敌方最前排的一名敌人造成 2 点物理伤害，并使其行动条进度 -20；并把目标撞退一格（摔投）。贴身时露出破绽，自身防御 -1（5tick）。目标生命低于 50% 时，摔投追加 1 点物理伤害；否则若自身战意 ≥2，摔投额外推条 10。",
      "cost": {
        "energy": 2,
        "cooldown": 10,
        "castTime": 0
      },
      "reach": "melee",
      "target": {
        "selectionMode": "manual",
        "request": {
          "mode": "unit",
          "faction": "enemy",
          "scope": "point",
          "pickCount": 1,
          "anchor": "enemy_front"
        },
        "fallbackSort": "index_asc"
      },
      "effects": [
        {
          "type": "damage",
          "element": "physical",
          "value": 2,
          "armorPierceRatio": 0.4,
          "note": "贴身缠斗：格斗术无视 40% 护甲（C）"
        },
        {
          "type": "modify_resource",
          "resource": "gauge.current",
          "value": -20,
          "mode": "delta"
        },
        {
          "type": "move",
          "op": "push_back",
          "target": "target",
          "note": "摔投：贴身缠住的下一步就是把对方撞退一格"
        },
        {
          "type": "modify_stat",
          "stat": "defense",
          "value": -1,
          "mode": "delta",
          "duration": 5,
          "target": "self",
          "note": "贴身时露出破绽"
        },
        {
          "op": "if",
          "condition": {
            "kind": "hp_percent",
            "side": "target",
            "cmp": "<",
            "n": 0.5
          },
          "then": [
            {
              "type": "damage",
              "element": "physical",
              "value": 1,
              "target": "target",
              "note": "摔投追击：虚弱者被掼得更狠"
            }
          ],
          "else": [
            {
              "op": "if",
              "condition": {
                "kind": "has_status",
                "side": "self",
                "id": "war_spirit",
                "cmp": ">=",
                "n": 2
              },
              "then": [
                {
                  "type": "modify_resource",
                  "resource": "gauge.current",
                  "value": -10,
                  "mode": "delta",
                  "target": "target",
                  "note": "战意·缠劲：摔投再推一档"
                }
              ],
              "else": [],
              "note": "战意读档：≥2 层时额外推条 10"
            }
          ],
          "note": "低血追加伤害；否则战意≥2 时额外推条"
        }
      ],
      "tentative": false
    },
