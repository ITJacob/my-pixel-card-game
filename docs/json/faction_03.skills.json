        "on_turn_start"
      ],
      "effects": [
        {
          "op": "if",
          "condition": {
            "kind": "meter_compare",
            "key": "rule_balance",
            "cmp": ">=",
            "n": 5
          },
          "then": [
            {
              "type": "mount_status",
              "statusId": "order_favor",
              "duration": 1,
              "durationUnit": "self_turn",
              "refresh": true,
              "target": "self",
              "note": "天平秩序赐：秩序极 ≥+5，受击回血 1"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "condition": {
            "kind": "meter_compare",
            "key": "rule_balance",
            "cmp": "<=",
            "n": -5
          },
          "then": [
            {
              "type": "mount_status",
              "statusId": "entropy_favor",
              "duration": 1,
              "durationUnit": "self_turn",
              "refresh": true,
              "target": "self",
              "note": "天平熵赐：熵极 ≤−5，伤害 +1"
            }
          ],
          "else": []
        }
      ],
      "tentative": false
    },
