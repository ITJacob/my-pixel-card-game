      "name": "创世序",
      "kind": "passive",
      "sequence": 9,
      "rarity": "common",
      "axis": "genesis",
      "flagship": false,
      "describe": "被动。自身回合开始时读取光照度：光 ≥5 时获得「光孕」（行动条速率 +1，每回合重判）——光足则万物速生。",
      "hook": [
        "on_turn_start"
      ],
      "effects": [
        {
          "op": "if",
          "condition": {
            "kind": "meter_compare",
            "key": "luminance",
            "cmp": ">=",
            "n": 5
          },
          "then": [
            {
              "type": "mount_status",
              "statusId": "light_womb",
              "duration": 1,
              "durationUnit": "self_turn",
              "refresh": true,
              "target": "self",
              "note": "光孕：光照度 ≥5 挂载（速率 +1）"
            }
          ],
          "else": []
        }
      ],
      "tentative": false
    },
