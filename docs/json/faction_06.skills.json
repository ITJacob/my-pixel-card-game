      "name": "流星雨",
      "kind": "active",
      "sequence": 5,
      "rarity": "rare",
      "axis": "star",
      "flagship": false,
      "describe": "主动（0 吟唱，30tick CD）。按命运值当前极性结算（只读，不推账户）：≥+5 → 星坠兑现，敌方全体受 3 点雷属性伤害；≤−5 → 逆境星愈，自身回复 3 点生命。两极均不足时无效。",
      "cost": {
        "energy": 3,
        "cooldown": 30,
        "castTime": 0
      },
      "reach": "none",
      "target": {
        "selectionMode": "auto",
        "request": {
          "mode": "unit",
          "faction": "self",
          "scope": "point"
        },
        "consumption": "instant"
      },
      "effects": [
        {
          "op": "if",
