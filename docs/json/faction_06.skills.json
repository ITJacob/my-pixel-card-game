            "key": "fate_value",
            "cmp": ">=",
            "n": 5
          },
          "then": [
            {
              "type": "damage",
              "element": "lightning",
              "value": 3,
              "target": "all_enemies",
              "note": "流星雨·赐福兑现：敌全体 3 点雷伤"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "condition": {
            "kind": "meter_compare",
            "key": "fate_value",
            "cmp": "<=",
            "n": -5
          },
          "then": [
            {
              "type": "heal",
              "value": 3,
              "target": "self",
              "note": "流星雨·逆境星愈：自身回复 3"
            }
          ],
          "else": []
        }
      ],
      "tentative": false
    }
