  "cards": [
    {
      "id": "f06_stargaze",
      "name": "观星",
      "kind": "passive",
      "sequence": 9,
      "rarity": "common",
      "axis": "star",
      "flagship": false,
      "describe": "被动。自身回合开始时读取命运值（只读，不推账户）：≥+5 获得「赐福」（伤害 +1）；≤−5 获得「潮汐」（行动条速率 +1）——高潮收租，低潮攒运。",
      "hook": [
        "on_turn_start"
      ],
      "effects": [
        {
          "op": "if",
          "condition": {
            "kind": "meter_compare",
            "key": "fate_value",
            "cmp": ">=",
            "n": 5
          },
          "then": [
            {
              "type": "mount_status",
              "statusId": "star_blessing",
              "duration": 1,
              "durationUnit": "self_turn",
              "refresh": true,
              "target": "self",
              "note": "赐福：命运 ≥+5 挂载（伤害 +1）"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "condition": {
            "kind": "meter_compare",
            "key": "fate_value",
            "cmp": "<=",
            "n": -5
          },
          "then": [
            {
              "type": "mount_status",
              "statusId": "star_tide",
              "duration": 1,
              "durationUnit": "self_turn",
              "refresh": true,
              "target": "self",
              "note": "潮汐：命运 ≤−5 挂载（速率 +1）"
            }
          ],
          "else": []
        }
      ],
      "tentative": false
    },
    {
